{
  "name": "vibesquare-node",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "seed": "ts-node scripts/seed.ts",
    "seed:auth": "ts-node scripts/seed-auth.ts",
    "seed:all": "npm run seed && npm run seed:auth",
    "migrate:latest": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "migrate:status": "knex migrate:status --knexfile knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts -x ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Backend API for VibeSquare Gallery",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.11",
    "@langchain/google-genai": "^2.1.6",
    "@langchain/langgraph": "^1.0.7",
    "@langchain/openai": "^1.2.1",
    "@toon-format/toon": "^2.1.0",
    "@types/jsdom": "^21.1.7",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "gpt-tokens": "^1.3.14",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.9.0",
    "joi": "^18.0.2",
    "jsdom": "^22.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mongoose": "^9.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "openai": "^6.15.0",
    "pg": "^8.16.3",
    "stripe": "^20.1.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.15.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
